rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Administrator verification: Email check or trusted database document
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'alwwwan.farhan@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Project Validation Helper
    function isValidProject(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 2000 &&
             data.type is string && (data.type == 'image' || data.type == 'video') &&
             data.media_url is string && data.media_url.size() <= 500 &&
             data.project_for is string && data.project_for.size() <= 200 &&
             (!('during' in data) || (data.during is string && data.during.size() <= 100)) &&
             (!('skill_set' in data) || (data.skill_set is string && data.skill_set.size() <= 500)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100));
    }

    // Certificate Validation Helper
    function isValidCertificate(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.issuer is string && data.issuer.size() > 0 && data.issuer.size() <= 200 &&
             data.date is string && data.date.size() <= 100 &&
             data.image is string && data.image.size() <= 500 &&
             (!('link' in data) || (data.link is string && data.link.size() <= 500));
    }

    // Article Validation Helper
    function isValidArticle(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
             data.excerpt is string && data.excerpt.size() > 0 && data.excerpt.size() <= 1000 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 25000 &&
             data.category is string && data.category.size() <= 100 &&
             (!('readTime' in data) || (data.readTime is string && data.readTime.size() <= 50)) &&
             (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 500)) &&
             (!('slug' in data) || (data.slug is string && data.slug.size() <= 200));
    }

    // PROJECTS COLLECTION
    match /projects/{projectId} {
      allow read: if true;

      allow create: if isValidId(projectId) &&
                       isAdmin() &&
                       isValidProject(incoming());

      allow update: if isValidId(projectId) &&
                       isAdmin() &&
                       isValidProject(incoming());

      allow delete: if isValidId(projectId) &&
                       isAdmin();
    }

    // CERTIFICATES COLLECTION
    match /certificates/{certificateId} {
      allow read: if true;

      allow create: if isValidId(certificateId) &&
                       isAdmin() &&
                       isValidCertificate(incoming());

      allow update: if isValidId(certificateId) &&
                       isAdmin() &&
                       isValidCertificate(incoming());

      allow delete: if isValidId(certificateId) &&
                       isAdmin();
    }

    // ARTICLES / BLOG COLLECTION
    match /articles/{articleId} {
      allow read: if true;

      allow create: if isValidId(articleId) &&
                       isAdmin() &&
                       isValidArticle(incoming());

      allow update: if isValidId(articleId) &&
                       isAdmin() &&
                       isValidArticle(incoming());

      allow delete: if isValidId(articleId) &&
                       isAdmin();
    }

    // ADMINS COLLECTION
    match /admins/{adminId} {
      allow read: if isValidId(adminId) && isAdmin();
      allow write: if false; // Managed through security console or backend
    }
  }
}
